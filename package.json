{
  "name": "laweditor",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "dependencies": {
    "bend-ui": "github:isabellaherman/Bend-UI#main"
  },
  "scripts": {
    "check": "bend PROOF.bend && bend server.bend --check-only",
    "build": "bend web/index.html -o dist",
    "server": "bend server.bend -o dist/laweditor-server",
    "start": "bun run build && bun run server && mkdir -p project && cd project && ../dist/laweditor-server ../dist ../AGENT.md"
  }
}
